{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/airesearch/schema/rl_metrics.json",
  "title": "RLTrainingMetrics",
  "type": "object",
  "description": "Metrics schema for RL training runs (toy waypoint env, PPO, GRPO, etc.)",
  "required": ["run_id", "training_config", "episodes"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this training run"
    },
    "domain": {
      "type": "string",
      "enum": ["rl", "toy_waypoint"],
      "default": "toy_waypoint"
    },
    "git": {
      "type": "object",
      "description": "Git metadata for reproducibility",
      "properties": {
        "repo": {"type": "string"},
        "commit": {"type": "string"},
        "branch": {"type": "string"}
      },
      "additionalProperties": true
    },
    "training_config": {
      "type": "object",
      "description": "Training configuration parameters",
      "properties": {
        "algorithm": {"type": "string", "enum": ["PPO", "GRPO", "SAC", "random"]},
        "episodes": {"type": "integer"},
        "seed": {"type": "integer"},
        "max_episode_steps": {"type": "integer"},
        "learning_rate": {"type": "number"},
        "gamma": {"type": "number"},
        "gae_lambda": {"type": "number"},
        "clip_epsilon": {"type": "number"},
        "value_loss_coef": {"type": "number"},
        "entropy_coef": {"type": "number"},
        "max_grad_norm": {"type": "number"},
        "sft_checkpoint": {"type": "string", "description": "Path to SFT/BC checkpoint if used"}
      },
      "additionalProperties": true
    },
    "episodes": {
      "type": "array",
      "description": "Per-episode metrics",
      "items": {
        "type": "object",
        "required": ["episode", "return"],
        "properties": {
          "episode": {"type": "integer"},
          "return": {"type": "number", "description": "Cumulative reward for episode"},
          "length": {"type": "integer", "description": "Number of steps in episode"},
          "success": {"type": "boolean", "description": "Whether episode was successful"},
          "final_dist": {"type": "number", "description": "Final distance to target"},
          "ade": {"type": "number", "description": "Average Displacement Error"},
          "fde": {"type": "number", "description": "Final Displacement Error"},
          "delta_norm": {"type": "number", "description": "Mean norm of delta waypoints (for RL refinement)"}
        }
      }
    },
    "eval_intervals": {
      "type": "array",
      "description": "Evaluation metrics at training intervals",
      "items": {
        "type": "object",
        "required": ["episode", "mean_reward"],
        "properties": {
          "episode": {"type": "integer"},
          "mean_reward": {"type": "number"},
          "std_reward": {"type": "number"},
          "mean_delta_norm": {"type": "number"},
          "max_delta_norm": {"type": "number"},
          "std_delta_norm": {"type": "number"},
          "success_rate": {"type": "number"},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Aggregate metrics across training",
      "properties": {
        "final_mean_reward": {"type": "number"},
        "final_std_reward": {"type": "number"},
        "mean_return": {"type": "number"},
        "std_return": {"type": "number"},
        "mean_episode_length": {"type": "number"},
        "success_rate": {"type": "number"},
        "total_timesteps": {"type": "integer"},
        "training_time_seconds": {"type": "number"},
        "final_delta_norm": {"type": "number", "description": "Mean delta norm at end of training"}
      },
      "additionalProperties": true
    },
    "update_metrics": {
      "type": "array",
      "description": "PPO/GRPO update-level metrics (policy loss, value loss, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "episode": {"type": "integer"},
          "policy_loss": {"type": "number"},
          "value_loss": {"type": "number"},
          "entropy": {"type": "number"},
          "kl": {"type": "number"},
          "clip_fraction": {"type": "number"},
          "explained_variance": {"type": "number"}
        }
      }
    }
  },
  "additionalProperties": true
}
